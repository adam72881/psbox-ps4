+JUICE_EXPORT int juice_send_dtls_fanout(juice_agent_t *agent, const char *data, size_t size, int ds) {
+	if (!agent || (!data && size))
+		return JUICE_ERR_INVALID;
+
+	int ret = agent_send_dtls_fanout(agent, data, size, ds);
+	if (ret >= 0)
+		return JUICE_ERR_SUCCESS;
+	if (ret == -SEAGAIN || ret == -SEWOULDBLOCK)
+		return JUICE_ERR_AGAIN;
+	if (ret == -SEMSGSIZE)
+		return JUICE_ERR_TOO_LARGE;
+	return JUICE_ERR_FAILED;
+}
 
