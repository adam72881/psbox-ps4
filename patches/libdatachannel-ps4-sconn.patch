+	/* PSBOX_SCONN: stesso layout di usrsctp (HAVE_SCONN_LEN). La famiglia sta
+	 * al byte 1, la lunghezza 16 al byte 0. Il layout Linux (famiglia uint16
+	 * all'offset 0) fa leggere 0 a usrsctp e il bind torna EAFNOSUPPORT. */
+	static_assert(sizeof(struct sockaddr_conn) == 16, "sockaddr_conn");
+	static_assert(offsetof(struct sockaddr_conn, sconn_family) == 1, "sconn_family");
 	struct sockaddr_conn sconn = {};
 	sconn.sconn_family = AF_CONN;
