+void agent_halt(juice_agent_t *agent) {
+	conn_lock(agent);
+	for (int i = 0; i < agent->entries_count; ++i) {
+		agent->entries[i].state = AGENT_STUN_ENTRY_STATE_CANCELLED;
+		agent->entries[i].next_transmission = 0;
+	}
+	atomic_store(&agent->selected_entry, NULL);
+	conn_unlock(agent);
+	conn_interrupt(agent);
+	JLOG_INFO("ICE halted: STUN keepalives cancelled");
+}
+
+int agent_send_dtls_fanout(juice_agent_t *agent, const char *data, size_t size, int ds) {
+	int ret = agent_send(agent, data, size, ds);
+	agent_stun_entry_t *selected = atomic_load(&agent->selected_entry);
+	addr_record_t extra[8];
+	int nextra = 0;
+	conn_lock(agent);
+	for (int i = 0; i < agent->entries_count && nextra < 8; ++i) {
+		agent_stun_entry_t *entry = agent->entries + i;
+		if (entry == selected || entry->type != AGENT_STUN_ENTRY_TYPE_CHECK || !entry->pair)
+			continue;
+		if (entry->relay_entry)
+			continue;
+		if (entry->state != AGENT_STUN_ENTRY_STATE_SUCCEEDED &&
+		    entry->state != AGENT_STUN_ENTRY_STATE_SUCCEEDED_KEEPALIVE &&
+		    entry->pair->state != ICE_CANDIDATE_PAIR_STATE_SUCCEEDED)
+			continue;
+		extra[nextra++] = entry->record;
+	}
+	conn_unlock(agent);
+	for (int i = 0; i < nextra; ++i) {
+		if (agent_direct_send(agent, &extra[i], data, size, ds) >= 0 && ret < 0)
+			ret = 0;
+	}
+	if (nextra > 0)
+		JLOG_INFO("DTLS handshake copied to %d extra succeeded pairs", nextra);
+	return ret;
+}
